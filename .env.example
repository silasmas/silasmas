APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Compte admin Filament (créé par php artisan db:seed)
ADMIN_EMAIL=admin@silasmas.com
ADMIN_PASSWORD=Password123!

# Routes HTTP /deploy/* ?secret=... (désactivées par défaut)
DEPLOY_MIGRATE_ENABLED=false
DEPLOY_SEED_ENABLED=false
DEPLOY_STORAGE_LINK_ENABLED=false
DEPLOY_SECRET=

# Front Next.js (CORS + liens absolus) — en prod API : https://silasmas.com
# Site public Next.js — OBLIGATOIRE en prod API : https://silasmas.com (e-mails, espace participant)
FRONTEND_URL=https://silasmas.com
# Origines autorisées pour les appels API depuis le navigateur (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://silasmas.com,https://www.silasmas.com
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FlexPay — Mobile Money + carte bancaire (inscriptions Academy payantes)
FLEXPAY_API_TOKEN=
FLEXPAY_MARCHAND=
# Mobile Money : paymentService (DGRAD) OU /mobile selon votre compte marchand FlexPay
FLEXPAY_GATEWAY_MOBILE=https://backend.flexpay.cd/api/rest/v1/paymentService
FLEXPAY_GATEWAY_CARD=https://backend.flexpay.cd/api/rest/v1/card
FLEXPAY_GATEWAY_CHECK=https://backend.flexpay.cd/api/rest/v1/check
# Codes type opérateur (à ajuster selon votre compte marchand FlexPay)
FLEXPAY_TYPE_MPESA=1
FLEXPAY_TYPE_AIRTEL=2
FLEXPAY_TYPE_ORANGE=3
FLEXPAY_TYPE_AFRIMONEY=4

# Webhooks optionnels pour SMS / WhatsApp (rappels Academy)
ACADEMY_SMS_WEBHOOK_URL=
ACADEMY_WHATSAPP_WEBHOOK_URL=
ACADEMY_ADMIN_ALERT_EMAIL=ir-masimango@silasmas.com
